# PricePing Environment Variables

# Price APIs
# DiaData API (free — provides crypto, commodities, forex)
DIADATA_API_URL=https://api.diadata.org/v1/assetQuotation

FINNHUB_KEY=Your-finnhub-api-key

TWELVE_DATA_KEY=YOUR_TWELVE_DATA_KEY_HERE

# Server Configuration
PORT=3000
NODE_ENV=development

# Subscription Settings
FREE_ALERTS_PER_DAY=3
PREMIUM_ALERTS_PER_DAY=50
SUBSCRIPTION_PRICE=2000

# Termii Multi-Channel Alerts (SMS + WhatsApp)
# Get your API key from https://accounts.termii.com/
Termii_api_key=YOUR_TERMII_API_KEY_HERE
# Sender ID registered in your Termii dashboard (max 11 chars, alphanumeric)
TERMII_SENDER_ID=PricePing

# 🇳🇬 NGX Pulse API Key
# Reliable NGX stock data API (free Personal tier: 100 req/day)
# Get your key at https://www.ngxpulse.ng
NGX_PULSE_KEY=Your-api-key

# 📊 Deriv Synthetic Indices (Volatility, BOOM, CRASH, etc.)
# App ID from https://developers.deriv.com — supports both numeric and alphanumeric
# Public fallback 1089 is used automatically if your App ID gets rejected
# DERIV_APP_ID=33fY69rUAyjYH9yiOCtx2
# Optional: API token for authenticated requests
# DERIV_API_TOKEN=your_token_here
