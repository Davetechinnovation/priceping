# PricePing Environment Variables

# WhatsApp Business API (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Database
DB_PATH=./data/priceping.db

# Price APIs - DiaData API
DIADATA_API_URL=https://api.diadata.org/v1/assetQuotation

# Server Configuration
PORT=3000
NODE_ENV=development

# Subscription Settings
FREE_ALERTS_PER_DAY=3
PREMIUM_ALERTS_PER_DAY=50
SUBSCRIPTION_PRICE=2000

# SMS Backup (Optional)
TERMII_API_KEY=your_termii_api_key
